# Copy to .env.local and fill in. Vite inlines every VITE_* variable into the
# shipped bundle, so only the anon/publishable key belongs here — never a
# service-role key or model provider key.

# Local stack (npx supabase start from repo root):
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY=<from `npx supabase status`>

# Hosted project:
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=<anon/publishable key from dashboard → Settings → API>

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
